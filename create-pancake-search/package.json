{
  "name": "create-pancake-search",
  "version": "0.3.1",
  "description": "Scaffold a Pancake-backed Cloudflare Worker search app.",
  "type": "module",
  "bin": {
    "create-pancake-search": "./bin/create-pancake-search.mjs"
  },
  "exports": {
    "./docusaurus": "./docusaurus/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "docusaurus",
    "src",
    "tools",
    "templates",
    "schemas",
    "README.md"
  ],
  "scripts": {
    "smoke": "PANCAKE_SEARCH_STUB_EMBEDDINGS=1 node bin/create-pancake-search.mjs --name /tmp/pancake-search-smoke --source ../docs --no-deploy --yes --force"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "pancake-wasm": "^0.3.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0"
}
