{
  "name": "pancake-wasm",
  "version": "0.1.0",
  "description": "HNSW vector search in WebAssembly. Runs in Node.js, browsers, and Cloudflare Workers with no native dependencies.",
  "main": "pancake.js",
  "types": "pancake.d.ts",
  "exports": {
    ".": {
      "workerd": {
        "types": "./pancake.web.d.ts",
        "default": "./pancake.workerd.mjs"
      },
      "browser": {
        "types": "./pancake.web.d.ts",
        "default": "./pancake.web.mjs"
      },
      "import": {
        "types": "./pancake.d.ts",
        "default": "./pancake.node.mjs"
      },
      "require": {
        "types": "./pancake.d.ts",
        "default": "./pancake.js"
      },
      "default": {
        "types": "./pancake.d.ts",
        "default": "./pancake.js"
      }
    },
    "./web": {
      "workerd": {
        "types": "./pancake.web.d.ts",
        "default": "./pancake.workerd.mjs"
      },
      "browser": {
        "types": "./pancake.web.d.ts",
        "default": "./pancake.web.mjs"
      },
      "import": {
        "types": "./pancake.web.d.ts",
        "default": "./pancake.web.mjs"
      },
      "default": {
        "types": "./pancake.web.d.ts",
        "default": "./pancake.web.mjs"
      }
    },
    "./node": {
      "import": {
        "types": "./pancake.d.ts",
        "default": "./pancake.node.mjs"
      },
      "require": {
        "types": "./pancake.d.ts",
        "default": "./pancake.js"
      },
      "default": {
        "types": "./pancake.d.ts",
        "default": "./pancake.js"
      }
    },
    "./engine.wasm": "./dist/engine.wasm"
  },
  "files": [
    "pancake.js",
    "pancake.node.mjs",
    "pancake.web.mjs",
    "pancake.workerd.mjs",
    "pancake-core.js",
    "pancake-errors.js",
    "pancake-loader.js",
    "pancake.d.ts",
    "pancake.web.d.ts",
    "dist/engine.js",
    "dist/engine.wasm",
    "dist/engine.scalar.js",
    "dist/engine.scalar.wasm",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build-engine.mjs",
    "build:scalar": "node scripts/build-all.mjs --scalar-only",
    "build:all": "node scripts/build-all.mjs",
    "bench": "node benchmarks/run.js",
    "demo:data": "node scripts/make-demo-vectors.mjs",
    "demo": "npm run demo:data && node examples/demo/technical_demo_cli.js",
    "test": "node run_tests.js && node test/model_c_loader.js",
    "test:browser": "node test/browser_smoke.js",
    "test:worker-web": "node test/test_worker_web_entry.js",
    "test:simd": "node test/simd_parity.js",
    "test:fuzz": "node test/fuzz_import.js",
    "pack:dry-run": "node scripts/pack-dry-run.mjs",
    "prepublishOnly": "npm run build:all && npm test && npm run test:fuzz && npm run test:simd && npm run test:browser && npm run test:worker-web && npm run pack:dry-run"
  },
  "keywords": [
    "vector-search",
    "ann",
    "hnsw",
    "wasm",
    "webassembly",
    "simd",
    "int8",
    "quantization",
    "embedding",
    "embeddings",
    "nearest-neighbor",
    "similarity-search",
    "cloudflare-workers",
    "edge",
    "edge-compute"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcn92/pancake.git"
  },
  "bugs": {
    "url": "https://github.com/mcn92/pancake/issues"
  },
  "homepage": "https://github.com/mcn92/pancake#readme",
  "author": "Matthew Noonan",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=16"
  },
  "sideEffects": false,
  "devDependencies": {
    "faiss-node": "^0.5.1",
    "hnswlib-node": "^3.0.0",
    "playwright": "^1.60.0",
    "usearch": "^2.25.1",
    "vite": "^8.0.16",
    "wrangler": "^4.81.1"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
